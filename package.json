{
  "name": "jersey-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "db:purge-demo": "tsx prisma/purge-demo.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts --demo",
    "jobs:run": "tsx --conditions=react-server scripts/run-jobs.ts",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  }
}
