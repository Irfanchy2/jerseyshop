// JERSEY STUDIO — database schema
//
// Conventions
// - All money is stored as integer minor units (paisa for BDT) in fields ending in `Minor`.
//   Never store money as floats. See src/lib/money.ts.
// - Secrets (courier/payment/AI credentials) are stored AES-256-GCM encrypted
//   (see src/lib/crypto.ts). They are never sent to the browser.
// - Customer-uploaded try-on photos are stored in private object storage and referenced by key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

enum UserKind {
  CUSTOMER
  STAFF
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  phone              String?
  name               String
  passwordHash       String
  kind               UserKind  @default(CUSTOMER)
  roleId             String?
  role               Role?     @relation(fields: [roleId], references: [id])
  isActive           Boolean   @default(true)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile            CustomerProfile?
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  addresses          Address[]
  orders             Order[]
  carts              Cart[]
  wishlist           WishlistItem[]
  recentlyViewed     RecentlyViewed[]
  designs            CustomDesign[]
  tryOnJobs          TryOnJob[]
  reviews            Review[]
  auditLogs          AuditLog[]
  inquiries          SupportInquiry[]
  deletionRequests   DataDeletionRequest[]
  notifications      Notification[]

  @@index([kind])
}

model CustomerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLocale   String    @default("en")
  marketingConsent  Boolean   @default(false)
  marketingConsentAt DateTime?
  favoriteTeam      String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Session {
  id          String   @id // SHA-256 hash of the session token; raw token lives only in the cookie
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String   @default("customer") // "customer" | "admin"
  expiresAt   DateTime
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

model Permission {
  key         String           @id // e.g. "products.write"
  description String
  group       String
  roles       RolePermission[]
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String   @default("Home")
  name         String
  phone        String
  line1        String
  area         String
  district     String
  division     String
  postcode     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  nameBn      String?
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum TeamKind {
  CLUB
  NATIONAL
}

model Team {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  nameBn       String?
  kind         TeamKind
  country      String?
  league       String?
  primaryHex   String    @default("#111111")
  secondaryHex String    @default("#ffffff")
  products     Product[]
}

enum CollectionKind {
  CURATED
  CLUB
  NATIONAL
  SEASONAL
  TRAINING
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  nameBn      String?
  description String?
  kind        CollectionKind      @default(CURATED)
  imageUrl    String?
  accentHex   String?
  isFeatured  Boolean             @default(false)
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum KitType {
  HOME
  AWAY
  THIRD
  GOALKEEPER
  TRAINING
  RETRO
  FAN
  CUSTOM
}

model Product {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  nameBn            String?
  description       String
  descriptionBn     String?
  status            ProductStatus       @default(DRAFT)
  categoryId        String
  category          Category            @relation(fields: [categoryId], references: [id])
  teamId            String?
  team              Team?               @relation(fields: [teamId], references: [id])
  season            String?
  kitType           KitType             @default(HOME)
  gender            String              @default("unisex")
  priceMinor        Int
  compareAtMinor    Int?                // original price shown struck-through when > price
  salePriceMinor    Int?                // scheduled promotional price
  saleStartsAt      DateTime?
  saleEndsAt        DateTime?
  fabric            String?
  care              String?
  fit               String?
  tags              String[]
  isFeatured        Boolean             @default(false)
  isBestSeller      Boolean             @default(false)
  // Generated-art design spec used for original catalog illustrations (pattern/colors).
  design            Json?
  // Virtual try-on
  tryOnEnabled      Boolean             @default(false)
  garmentImageUrl   String?             // flat-lay garment image sent to the try-on provider
  // Personalisation
  customizable      Boolean             @default(false)
  templateId        String?
  template          CustomizationTemplate? @relation(fields: [templateId], references: [id])
  model3dUrl        String?
  seoTitle          String?
  seoDescription    String?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  images            ProductImage[]
  variants          ProductVariant[]
  collections       ProductCollection[]
  reviews           Review[]
  wishlistedBy      WishlistItem[]
  recentlyViewed    RecentlyViewed[]
  designs           CustomDesign[]
  tryOnJobs         TryOnJob[]
  orderItems        OrderItem[]
  bundleItems       BundleItem[]

  @@index([status, categoryId])
  @@index([teamId])
  @@index([season])
  @@index([isFeatured])
  @@index([createdAt])
}

enum ImageKind {
  FRONT
  BACK
  DETAIL
  LIFESTYLE
  GARMENT
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  kind      ImageKind @default(FRONT)
  sortOrder Int       @default(0)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                String              @id @default(cuid())
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String              @unique
  size              String
  color             String
  colorHex          String              @default("#111111")
  priceMinor        Int?                // overrides product price when set
  stock             Int                 @default(0)
  lowStockThreshold Int                 @default(5)
  isActive          Boolean             @default(true)
  sortOrder         Int                 @default(0)
  movements         InventoryMovement[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

model InventoryMovement {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta      Int
  reason     String         // "order", "cancel", "restock", "adjustment", "return", "seed"
  orderId    String?
  actorId    String?
  note       String?
  stockAfter Int
  createdAt  DateTime       @default(now())

  @@index([variantId, createdAt])
}

model Bundle {
  id              String       @id @default(cuid())
  name            String
  description     String?
  discountPercent Int
  isActive        Boolean      @default(true)
  items           BundleItem[]
  createdAt       DateTime     @default(now())
}

model BundleItem {
  bundleId  String
  productId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
}

// ───────────────────────────── Personalisation / 3D ─────────────────────────────

model CustomizationTemplate {
  id                String         @id @default(cuid())
  name              String
  modelUrl          String?        // optional licensed GLB/GLTF; procedural jersey used otherwise
  frontTextureUrl   String?
  backTextureUrl    String?
  // Printable areas in normalised texture coordinates {x,y,w,h} (0..1)
  nameArea          Json
  numberArea        Json
  frontNumberArea   Json?
  allowedColors     String[]       // hex values the seller can produce
  allowedFonts      String[]       // font keys, see src/lib/customizer.ts
  priceMinor        Int            @default(0)
  maxNameLength     Int            @default(12)
  maxNumberDigits   Int            @default(2)
  isActive          Boolean        @default(true)
  products          Product[]
  designs           CustomDesign[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model CustomDesign {
  id             String                 @id @default(cuid())
  productId      String
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateId     String
  template       CustomizationTemplate  @relation(fields: [templateId], references: [id])
  userId         String?
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  playerName     String
  playerNumber   String
  font           String
  baseColor      String
  textColor      String
  surchargeMinor Int
  savedToAccount Boolean                @default(false)
  createdAt      DateTime               @default(now())
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([userId])
}

// ───────────────────────────── Cart & orders ─────────────────────────────

model Cart {
  id                String     @id @default(cuid())
  tokenHash         String     @unique // guest cart cookie token (hashed)
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  couponCode        String?
  // Abandoned-cart tracking only with explicit consent.
  contactEmail      String?
  contactPhone      String?
  recoveryConsentAt DateTime?
  convertedOrderId  String?
  items             CartItem[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id             String         @id @default(cuid())
  cartId         String
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity       Int
  customDesignId String?
  customDesign   CustomDesign?  @relation(fields: [customDesignId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([cartId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  SSLCOMMERZ
}

model Order {
  id                String             @id @default(cuid())
  number            String             @unique
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  email             String?
  phone             String
  customerName      String
  status            OrderStatus        @default(PENDING)
  paymentStatus     PaymentStatus      @default(UNPAID)
  paymentMethod     PaymentMethod      @default(COD)
  currency          String             @default("BDT")
  subtotalMinor     Int
  customizationMinor Int               @default(0)
  discountMinor     Int                @default(0)
  shippingMinor     Int
  totalMinor        Int
  couponCode        String?
  shippingRateCode  String?
  notes             String?
  adminNotes        String?
  locale            String             @default("en")
  idempotencyKey    String             @unique // prevents duplicate submissions
  trackingTokenHash String?            // guest order tracking token
  isDemo            Boolean            @default(false) // seeded development data
  placedAt          DateTime           @default(now())
  confirmedAt       DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  updatedAt         DateTime           @updatedAt

  items             OrderItem[]
  address           OrderAddress?
  events            OrderStatusEvent[]
  payments          Payment[]
  shipments         Shipment[]
  couponRedemptions CouponRedemption[]

  @@index([status, placedAt])
  @@index([userId])
  @@index([phone])
  @@index([placedAt])
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName        String
  sku                String
  size               String
  color              String
  imageUrl           String?
  unitPriceMinor     Int
  quantity           Int
  customizationMinor Int             @default(0)
  customDesignId     String?
  customDesign       CustomDesign?   @relation(fields: [customDesignId], references: [id], onDelete: SetNull)
  customization      Json?           // immutable snapshot {playerName, playerNumber, font, colors}
  lineTotalMinor     Int
  reviews            Review[]

  @@index([orderId])
  @@index([productId])
}

model OrderAddress {
  id          String  @id @default(cuid())
  orderId     String  @unique
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  altPhone    String?
  line1       String
  area        String
  district    String
  division    String
  postcode    String?
  // Courier location mapping (Pathao city/zone/area ids) when resolved
  pathaoCityId Int?
  pathaoZoneId Int?
  pathaoAreaId Int?
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  isPublic  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentMethod
  amountMinor Int
  status      PaymentStatus @default(PENDING)
  tranId      String        @unique
  providerRef String?
  raw         Json?
  validatedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  description       String?
  type              CouponType
  value             Int                // percent (0-100) or minor units
  minSubtotalMinor  Int                @default(0)
  maxDiscountMinor  Int?
  startsAt          DateTime?
  endsAt            DateTime?
  usageLimit        Int?
  usedCount         Int                @default(0)
  perCustomerLimit  Int?
  isActive          Boolean            @default(true)
  redemptions       CouponRedemption[]
  createdAt         DateTime           @default(now())
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phone     String
  amountMinor Int
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, phone])
}

// ───────────────────────────── Shipping & couriers ─────────────────────────────

enum ProviderMode {
  MOCK
  SANDBOX
  LIVE
}

enum ConnectionStatus {
  UNTESTED
  CONNECTED
  ERROR
}

model ShippingProvider {
  id              String           @id @default(cuid())
  code            String           @unique // "steadfast" | "pathao"
  name            String
  isEnabled       Boolean          @default(false)
  isDefault       Boolean          @default(false)
  mode            ProviderMode     @default(MOCK)
  encryptedConfig String?          // AES-GCM encrypted JSON of credentials
  publicConfig    Json             @default("{}") // non-secret defaults: store id, delivery type, etc.
  status          ConnectionStatus @default(UNTESTED)
  lastCheckedAt   DateTime?
  lastError       String?
  // Pathao OAuth tokens (encrypted) and expiry
  encryptedToken  String?
  tokenExpiresAt  DateTime?
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())
}

model ShippingRate {
  id            String   @id @default(cuid())
  code          String   @unique // inside_dhaka | dhaka_suburbs | outside_dhaka
  name          String
  nameBn        String?
  feeMinor      Int
  etaText       String
  districts     String[] // districts this rate applies to; empty = fallback
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
}

enum ShipmentStatus {
  REQUESTED     // request in flight (lock state)
  BOOKED
  FAILED
  IN_TRANSIT
  DELIVERED
  PARTIAL_DELIVERED
  CANCELLED
  RETURNED
  HOLD
}

model Shipment {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerCode     String
  mode             ProviderMode
  status           ShipmentStatus  @default(REQUESTED)
  idempotencyKey   String          @unique
  consignmentId    String?
  trackingCode     String?
  providerStatus   String?
  codAmountMinor   Int
  deliveryFeeMinor Int?
  attemptCount     Int             @default(1)
  lastError        String?
  requestSummary   Json?           // sanitized request (no secrets)
  responseSummary  Json?
  bookedAt         DateTime?
  lastSyncedAt     DateTime?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           TrackingEvent[]

  @@index([orderId])
  @@index([providerCode, status])
  @@index([consignmentId])
}

model TrackingEvent {
  id             String   @id @default(cuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  providerStatus String
  description    String?
  source         String   // "webhook" | "poll" | "manual" | "booking"
  occurredAt     DateTime @default(now())
  raw            Json?

  @@index([shipmentId, occurredAt])
}

model CourierLog {
  id           String   @id @default(cuid())
  providerCode String
  operation    String
  success      Boolean
  httpStatus   Int?
  durationMs   Int?
  error        String?
  shipmentId   String?
  orderId      String?
  mode         ProviderMode
  createdAt    DateTime @default(now())

  @@index([providerCode, createdAt])
}

// ───────────────────────────── AI virtual try-on ─────────────────────────────

enum TryOnStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model TryOnJob {
  id               String         @id @default(cuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  ownerKeyHash     String         // hashed guest/session key — only the owner can read the job
  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider         String         // "google-vertex" | "demo"
  isDemo           Boolean        @default(false)
  usedSampleModel  Boolean        @default(false)
  personImageKey   String?
  garmentImageRef  String
  resultImageKey   String?
  status           TryOnStatus    @default(QUEUED)
  errorCode        String?
  errorMessage     String?
  attempts         Int            @default(0)
  consentAt        DateTime
  consentVersion   String
  saveToAccount    Boolean        @default(false)
  retainUntil      DateTime
  deletedAt        DateTime?
  ipHash           String?
  createdAt        DateTime       @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  generations      AiGenerationRecord[]

  @@index([ownerKeyHash, createdAt])
  @@index([status])
  @@index([retainUntil])
  @@index([ipHash, createdAt])
}

model AiGenerationRecord {
  id                 String   @id @default(cuid())
  jobId              String
  job                TryOnJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider           String
  model              String?
  success            Boolean
  latencyMs          Int?
  estimatedCostMicro Int      @default(0) // USD micro-units estimate
  error              String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────────── Reviews ─────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  rating      Int
  title       String?
  body        String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@unique([userId, productId])
  @@index([productId, status])
}

// ───────────────────────────── Customer engagement ─────────────────────────────

model WishlistItem {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model RecentlyViewed {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@id([userId, productId])
  @@index([userId, viewedAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("en")
  source         String?
  consentAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

model SupportInquiry {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  phone       String?
  orderNumber String?
  subject     String
  message     String
  status      String   @default("open")
  createdAt   DateTime @default(now())
}

model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String    // "tryon_images" | "account"
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

// ───────────────────────────── CMS & settings ─────────────────────────────

model HomepageSection {
  id               String    @id @default(cuid())
  type             String    // see src/lib/cms/sections.ts
  sortOrder        Int
  isEnabled        Boolean   @default(true)
  draftContent     Json
  publishedContent Json?
  draftEnabled     Boolean   @default(true)
  draftSortOrder   Int
  publishedAt      DateTime?
  updatedAt        DateTime  @updatedAt
}

model SiteSetting {
  key         String   @id // "brand" | "appearance" | "announcement" | "footer" | "tryon" | ...
  value       Json     // published value
  draftValue  Json?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model EncryptedSecret {
  key         String   @id // e.g. "tryon.google.serviceAccount", "payments.sslcommerz"
  ciphertext  String
  hint        String?  // last 4 chars for display
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  key          String   @unique
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  alt          String?
  folder       String   @default("general")
  uploadedById String?
  createdAt    DateTime @default(now())
}

// ───────────────────────────── Ops: analytics, audit, jobs ─────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  sessionId String?
  userId    String?
  productId String?
  orderId   String?
  path      String?
  utmSource String?
  utmCampaign String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([productId, name])
  @@index([utmCampaign])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String?
  diff       Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?   // null = visible to all staff
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

model Job {
  id          String    @id @default(cuid())
  type        String    // "tryon.generate" | "courier.sync" | "courier.book" | "tryon.purge"
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  lastError   String?
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
}
